{
  "name": "tech-practice",
  "version": "0.3.0",
  "private": true,
  "description": "Personal digital IC and programming practice desktop app",
  "overrides": {
    "dompurify": "3.4.17"
  },
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs && node scripts/build-launcher.mjs",
    "start": "electron .",
    "test": "node --test tests/core.test.mjs tests/plugins.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:startup": "node tests/startup.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:learning": "node tests/learning-ui.mjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "ajv": "8.20.0",
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.61.0",
    "marked": "18.1.2",
    "monaco-editor": "0.56.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
