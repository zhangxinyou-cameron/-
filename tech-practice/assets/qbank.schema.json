      "properties": {
        "source_path": {
          "$ref": "#/$defs/path"
        },
        "target_path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "source_path",
        "target_path"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
