{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bank_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "bank_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge"
      },
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "bank_id",
    "bank_version",
    "title",
    "description",
    "locale",
    "authors",
    "license",
    "knowledge_points",
    "questions",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QBank 1.0 personal technical learning bank",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])(?!.*//)(?!.*\\/$)[^\\x00-\\x1F]+$"
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "locator",
        "note"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "option": {
