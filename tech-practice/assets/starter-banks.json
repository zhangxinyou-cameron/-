    "files": {
      "rtl/starter/top_module.v": {
        "kind": "inline",
        "role": "starter",
        "content": "module top_module(input wire clk, input wire rst, input wire en,\n                  output reg [3:0] count);\n// Implement the sequential logic here.\nendmodule\n"
      },
      "rtl/reference/top_module.v": {
        "kind": "inline",
        "role": "reference",
        "content": "module top_module(input wire clk, input wire rst, input wire en,\n                  output reg [3:0] count);\nalways @(posedge clk) begin\n    if (rst) count <= 4'd0;\n    else if (en) count <= count + 4'd1;\nend\nendmodule\n"
      },
      "rtl/test/tb.v": {
        "kind": "inline",
        "role": "test",
        "content": "`timescale 1ns/1ps\nmodule tb;\nreg clk = 0;\nreg rst = 0;\nreg en = 0;\nwire [3:0] count;\nreg [3:0] expected = 0;\ninteger checks = 0;\ninteger i;\ntop_module dut(.clk(clk), .rst(rst), .en(en), .count(count));\nalways #5 clk = ~clk;\ntask tick;\n    input next_rst;\n    input next_en;\n    begin\n        @(negedge clk);\n        rst = next_rst;\n        en = next_en;\n        @(posedge clk);\n        if (next_rst) expected = 4'd0;\n        else if (next_en) expected = expected + 4'd1;\n        #1;\n        checks = checks + 1;\n        if (count !== expected) begin\n            $display(\"QB_CHECK_FAIL index=%0d time=%0t expected=%0d actual=%0d\",\n                     checks, $time, expected, count);\n            $fatal(1, \"counter mismatch\");\n        end\n    end\nendtask\ninitial begin\n    $timeformat(-9, 1, \" ns\", 0);\n    $dumpfile(\"wave.vcd\");\n    $dumpvars(0, tb);\n    tick(1, 0);\n    for (i = 0; i < 18; i = i + 1) tick(0, 1);\n    tick(0, 0);\n    tick(1, 1);\n    tick(0, 0);\n    tick(0, 1);\n    tick(0, 1);\n    if (checks != 24) $fatal(1, \"incomplete checks\");\n    $display(\"QB_TEST_DONE checks=%0d\", checks);\n    $finish;\nend\ninitial begin\n    #400;\n    $fatal(1, \"simulation timeout\");\nend\nendmodule\n"
      }
    }
