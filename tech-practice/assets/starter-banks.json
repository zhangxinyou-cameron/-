      {
        "id": "rtl_seq_assign",
        "revision": 1,
        "type": "single_choice",
        "title": "时序逻辑赋值方式",
        "domain": "digital_ic",
        "knowledge_point_ids": [
          "verilog_basics"
        ],
        "primary_knowledge_point_id": "verilog_basics",
        "difficulty": 1,
        "estimated_minutes": 2,
        "stem_md": "在单时钟同步 RTL 中，为避免时钟沿触发过程之间的阻塞赋值竞态，描述触发器状态更新通常推荐哪种写法？",
        "explanation_md": "opt_b 正确：时序状态更新通常采用非阻塞赋值。opt_a 阻塞赋值可能使同沿过程相互依赖执行次序。opt_c 连续赋值不直接描述该类时序状态更新。opt_d 延迟不能作为综合 RTL 的通用竞态解决方法。",
        "hints": [],
        "sources": [
          {
            "title": "原创协议演示题",
            "locator": "本设计文档配套示例",
            "note": "用于演示格式，正式发布前应复核。"
          }
        ],
        "answer": {
          "options": [
            {
              "id": "opt_a",
              "text_md": "在时钟沿过程里全部使用阻塞赋值 ="
            },
            {
              "id": "opt_b",
              "text_md": "在时钟沿过程里使用非阻塞赋值 <="
            },
            {
              "id": "opt_c",
              "text_md": "将状态更新全部改成 assign 连续赋值"
            },
            {
              "id": "opt_d",
              "text_md": "给每条语句加入任意 # 延迟"
            }
          ],
          "correct_option_id": "opt_b"
        }
      },
      {
        "id": "sync_reset_properties",
        "revision": 1,
        "type": "multiple_choice",
        "title": "同步复位的行为",
        "domain": "digital_ic",
        "knowledge_point_ids": [
          "reset_basics"
        ],
        "primary_knowledge_point_id": "reset_basics",
        "difficulty": 1,
        "estimated_minutes": 2,
        "stem_md": "对于仅由上升沿触发、复位优先的同步复位寄存器，哪些说法正确？",
        "explanation_md": "opt_a、opt_c 正确。同步复位仅在指定采样沿生效；没有有效沿不会更新状态；异步复位不属于本题前提。",
        "hints": [],
        "sources": [
          {
            "title": "原创协议演示题",
            "locator": "本设计文档配套示例",
            "note": "用于演示格式，正式发布前应复核。"
          }
        ],
        "answer": {
          "options": [
            {
              "id": "opt_a",
              "text_md": "复位在有效采样沿满足条件时才更新寄存器"
            },
            {
              "id": "opt_b",
              "text_md": "复位信号一变化，寄存器输出必定立刻更新"
            },
            {
              "id": "opt_c",
              "text_md": "没有时钟采样沿时，复位拉高本身不会使该寄存器更新"
            },
            {
              "id": "opt_d",
              "text_md": "同步复位与异步复位的过程敏感事件必须完全相同"
            }
          ],
          "correct_option_ids": [
            "opt_a",
            "opt_c"
          ]
        }
      },
